{
	"name": "autosave-control",
	"version": "1.0.12",
	"description": "Delay autosave until editing has stopped for a chosen number of seconds.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts debug.ts autosave ui settings styles.css",
		"wdio": "node ./scripts/run-wdio.mjs",
		"wdio:desktop": "node ./scripts/run-wdio.mjs --desktop-only",
		"wdio:android": "node ./scripts/run-android-wdio.mjs",
		"wdio:issue34": "wdio run ./wdio.issue34.conf.mts",
		"wdio:multivault": "wdio run ./wdio.multivault.conf.mts",
		"wdio:standard": "wdio run ./wdio.conf.mts --exclude ./test/specs/android.e2e.ts --exclude ./test/specs/quit-save.e2e.ts --exclude ./test/specs/quit-clean.e2e.ts --exclude ./test/specs/multi-vault.e2e.ts",
		"wdio:quit-clean": "node ./scripts/verify-quit-clean.mjs",
		"wdio:quit-save": "node ./scripts/verify-quit-save.mjs",
		"wdio:quit-manual": "node ./scripts/verify-quit-manual.mjs",
		"wdio:reload-no-save": "node ./scripts/verify-reload-no-save.mjs",
		"wdio:all": "node ./scripts/run-wdio.mjs"
	},
	"keywords": [
		"save",
		"frequency",
		"file",
		"autosave",
		"interval",
		"period",
		"time"
	],
	"author": "Miha Smrekar",
	"license": "MIT",
	"devDependencies": {
		"@eslint/css": "^1.3.0",
		"@eslint/js": "^9.39.4",
		"@eslint/json": "^0.14.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^16.18.126",
		"@wdio/appium-service": "^9.27.1",
		"@wdio/cli": "^9.27.0",
		"@wdio/globals": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"@wdio/spec-reporter": "^9.27.0",
		"appium": "^3.4.2",
		"appium-uiautomator2-driver": "^7.5.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"expect-webdriverio": "^5.6.5",
		"mocha": "^11.7.5",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.21.0",
		"typescript": "^4.9.5",
		"typescript-eslint": "^8.61.1",
		"wdio-obsidian-reporter": "^3.0.2",
		"wdio-obsidian-service": "^3.0.2"
	}
}
