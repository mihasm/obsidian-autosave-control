{
	"name": "autosave-control",
	"version": "0.0.18",
	"description": "Delay autosave until editing has stopped for a chosen number of seconds.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"wdio": "node ./scripts/run-wdio.mjs",
		"wdio:desktop": "node ./scripts/run-wdio.mjs --desktop-only",
		"wdio:android": "node ./scripts/run-android-wdio.mjs",
		"wdio:standard": "wdio run ./wdio.conf.mts --exclude ./test/specs/android.e2e.ts --exclude ./test/specs/quit-save.e2e.ts --exclude ./test/specs/quit-clean.e2e.ts",
		"wdio:quit-clean": "node ./scripts/verify-quit-clean.mjs",
		"wdio:quit-save": "node ./scripts/verify-quit-save.mjs",
		"wdio:all": "node ./scripts/run-wdio.mjs"
	},
	"keywords": [
		"save",
		"frequency",
		"file",
		"autosave",
		"interval",
		"period",
		"time"
	],
	"author": "Miha Smrekar",
	"license": "MIT",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^16.18.126",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"@wdio/appium-service": "^9.27.1",
		"@wdio/cli": "^9.27.0",
		"@wdio/globals": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"@wdio/spec-reporter": "^9.27.0",
		"appium": "^3.4.2",
		"appium-uiautomator2-driver": "^7.5.0",
		"esbuild": "0.17.3",
		"expect-webdriverio": "^5.6.5",
		"mocha": "^11.7.5",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.21.0",
		"typescript": "4.7.4",
		"wdio-obsidian-reporter": "^3.0.2",
		"wdio-obsidian-service": "^3.0.2"
	},
	"dependencies": {
		"watch": "1.0.2"
	}
}
